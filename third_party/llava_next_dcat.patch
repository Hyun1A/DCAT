@@ -62,4 +62,19 @@ def build_vision_projector(config, delay_load=False, **kwargs):
     if projector_type == "identity":
         return IdentityMap()
 
+    if projector_type == "aapool_mlp":
+        # Adaptive Average Pooling + MLP projector used by LLaVA-Video
+        # Checkpoint keys: mm_projector.mlp_projector.{0,2}.{weight,bias}
+        class AAPoolMLP(nn.Module):
+            def __init__(self, mm_hidden_size, hidden_size):
+                super().__init__()
+                self.mlp_projector = nn.Sequential(
+                    nn.Linear(mm_hidden_size, hidden_size),
+                    nn.GELU(),
+                    nn.Linear(hidden_size, hidden_size),
+                )
+            def forward(self, x, *args, **kwargs):
+                return self.mlp_projector(x)
+        return AAPoolMLP(config.mm_hidden_size, config.hidden_size)
+
     raise ValueError(f"Unknown projector type: {projector_type}")
